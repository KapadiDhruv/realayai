# Copy this file to .env.local (which is gitignored) and fill in real values.
# These are NEXT_PUBLIC_ vars — they are inlined into the browser bundle at
# build time, so never put secrets here (see .env.local.example for those).

# Google Analytics 4 Measurement ID (Admin > Data Streams > your stream, in
# the GA4 property). Leave unset to disable GA4 entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
