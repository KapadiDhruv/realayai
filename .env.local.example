# Copy this file to .env.local (which is gitignored) and fill in real values.
# These are read server-side only, in app/api/waitlist/route.ts — never
# exposed to the browser, so do NOT prefix them with NEXT_PUBLIC_.

# The /exec URL you get after deploying the Apps Script as a Web App.
# See google-apps-script/README.md for the exact steps.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXX/exec

# A long random string, shared between this app and the Apps Script's
# Script Properties (key SHARED_SECRET). Stops randoms who find the
# Apps Script URL from posting directly to your sheet.
# Generate one with: openssl rand -hex 32
GOOGLE_APPS_SCRIPT_SECRET=replace-with-a-long-random-string
